#!/bin/bash
# =============================================================================
# scripts/tools/package-release
# =============================================================================
# 创建 FastQTools 可分发包
#
# 用法:
#   ./scripts/tools/package-release [选项]
#
# 选项:
#   -v, --version VERSION   版本号 (默认: dev)
#   -t, --target TARGET     目标标识 (默认: linux-x86_64-gcc-glibc)
#   -b, --build-dir DIR     构建目录 (默认: 自动检测)
#   -o, --output-dir DIR    输出目录 (默认: dist)
#   --no-build              跳过构建，仅打包
#   -h, --help              显示帮助
#
# 示例:
#   # 本地构建并打包
#   ./scripts/tools/package-release -v 3.1.0
#
#   # 指定构建目录（CI 场景）
#   ./scripts/tools/package-release -v 3.1.0 -t linux-aarch64-musl-static -b build/release --no-build
#
# 产物命名:
#   fastqtools-v{VERSION}-{TARGET}.tar.gz
#   例: fastqtools-v3.1.0-linux-x86_64-gcc-glibc.tar.gz
# =============================================================================
set -euo pipefail

# =============================================================================
# 默认配置
# =============================================================================
VERSION="dev"
TARGET="linux-x86_64-gcc-glibc"
BUILD_DIR=""
OUTPUT_DIR="dist"
NO_BUILD=false

# =============================================================================
# 帮助信息
# =============================================================================
usage() {
    sed -n '2,/^# =====/{ /^# =====/d; s/^# //; s/^#//; p; }' "$0"
}

# =============================================================================
# 参数解析
# =============================================================================
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--version)   VERSION="$2"; shift 2 ;;
        -t|--target)    TARGET="$2"; shift 2 ;;
        -b|--build-dir) BUILD_DIR="$2"; shift 2 ;;
        -o|--output-dir) OUTPUT_DIR="$2"; shift 2 ;;
        --no-build)     NO_BUILD=true; shift ;;
        -h|--help)      usage; exit 0 ;;
        *)              echo "未知参数: $1"; usage; exit 1 ;;
    esac
done

# =============================================================================
# 自动检测构建目录
# =============================================================================
if [ -z "$BUILD_DIR" ]; then
    # 按优先级查找构建产物
    for dir in \
        "build/gcc-release" \
        "build/clang-release" \
        "build/release" \
        "build"; do
        if [ -f "$dir/FastQTools" ]; then
            BUILD_DIR="$dir"
            break
        fi
    done
fi

PACKAGE_NAME="fastqtools-v${VERSION}-${TARGET}"
PACKAGE_DIR="${OUTPUT_DIR}/${PACKAGE_NAME}"

echo ">>> FastQTools Release Packaging"
echo "    版本:     ${VERSION}"
echo "    目标:     ${TARGET}"
echo "    构建目录: ${BUILD_DIR:-<未找到>}"
echo "    输出:     ${OUTPUT_DIR}/${PACKAGE_NAME}.tar.gz"
echo ""

# =============================================================================
# 构建（可选）
# =============================================================================
if [ "$NO_BUILD" = "false" ]; then
    echo ">>> 构建 Release..."
    if [ -x "./scripts/core/build" ]; then
        ./scripts/core/build --compiler gcc --type Release
    else
        echo "错误: 构建脚本不可用"
        exit 1
    fi

    # 重新检测构建目录
    if [ -z "$BUILD_DIR" ]; then
        for dir in "build/gcc-release" "build/release" "build/clang-release"; do
            if [ -f "$dir/FastQTools" ]; then
                BUILD_DIR="$dir"
                break
            fi
        done
    fi
fi

# =============================================================================
# 验证构建产物
# =============================================================================
if [ -z "$BUILD_DIR" ] || [ ! -f "$BUILD_DIR/FastQTools" ]; then
    echo "错误: 未找到构建产物 FastQTools"
    echo "请先构建项目或使用 -b 指定构建目录"
    exit 1
fi

# =============================================================================
# 打包
# =============================================================================
echo ">>> 创建包目录: ${PACKAGE_DIR}"
rm -rf "${PACKAGE_DIR}"
mkdir -p "${PACKAGE_DIR}/bin"

# 二进制
cp "${BUILD_DIR}/FastQTools" "${PACKAGE_DIR}/bin/"
chmod +x "${PACKAGE_DIR}/bin/FastQTools"

# 文档
cp LICENSE "${PACKAGE_DIR}/" 2>/dev/null || true
cp README.md "${PACKAGE_DIR}/" 2>/dev/null || true
cp CHANGELOG.md "${PACKAGE_DIR}/" 2>/dev/null || true
if [ -d "docs" ]; then
    mkdir -p "${PACKAGE_DIR}/docs"
    cp -r docs/* "${PACKAGE_DIR}/docs/" 2>/dev/null || true
fi

# 压缩
echo ">>> 创建压缩包..."
mkdir -p "${OUTPUT_DIR}"
(cd "${OUTPUT_DIR}" && tar -czf "${PACKAGE_NAME}.tar.gz" "${PACKAGE_NAME}")

# 清理临时目录
rm -rf "${PACKAGE_DIR}"

# SHA256
ARCHIVE="${OUTPUT_DIR}/${PACKAGE_NAME}.tar.gz"
if command -v sha256sum >/dev/null 2>&1; then
    SHA256="$(sha256sum "$ARCHIVE" | cut -d' ' -f1)"
elif command -v shasum >/dev/null 2>&1; then
    SHA256="$(shasum -a 256 "$ARCHIVE" | cut -d' ' -f1)"
else
    SHA256="(sha256sum 不可用)"
fi

SIZE="$(du -h "$ARCHIVE" | cut -f1)"
echo ""
echo ">>> 打包完成!"
echo "    文件:   ${ARCHIVE}"
echo "    大小:   ${SIZE}"
echo "    SHA256: ${SHA256}"
