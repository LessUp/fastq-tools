{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "gcc-base",
            "hidden": true,
            "inherits": "base",
            "displayName": "GCC Base",
            "description": "Base configuration for the preferred GCC profile",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "environment": {
                "CC": "gcc",
                "CXX": "g++"
            }
        },
        {
            "name": "clang-base",
            "hidden": true,
            "inherits": "base",
            "displayName": "Clang Base",
            "description": "Base configuration for the preferred Clang profile with libc++",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -lc++abi"
            },
            "environment": {
                "CC": "clang",
                "CXX": "clang++"
            }
        },
        {
            "name": "conan-gcc-base",
            "hidden": true,
            "inherits": "gcc-base",
            "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake"
        },
        {
            "name": "conan-clang-base",
            "hidden": true,
            "inherits": "clang-base",
            "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake"
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "description": "Debug build with the preferred GCC profile",
            "inherits": "conan-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "description": "Release build with the preferred GCC profile (recommended for production)",
            "inherits": "conan-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc-v3-release",
            "displayName": "GCC Release (x86-64-v3)",
            "description": "Release build with x86-64-v3 (AVX2+FMA+BMI) baseline",
            "inherits": "gcc-release",
            "cacheVariables": {
                "FQTOOLS_CPU_BASELINE": "x86-64-v3"
            }
        },
        {
            "name": "gcc-relwithdebinfo",
            "displayName": "GCC RelWithDebInfo",
            "description": "Release build with debug info using the preferred GCC profile",
            "inherits": "conan-gcc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "description": "Debug build with the preferred Clang profile + libc++ (recommended for development)",
            "inherits": "conan-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "description": "Release build with the preferred Clang profile + libc++",
            "inherits": "conan-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-v3-release",
            "displayName": "Clang Release (x86-64-v3)",
            "description": "Release build with x86-64-v3 (AVX2+FMA+BMI) baseline",
            "inherits": "clang-release",
            "cacheVariables": {
                "FQTOOLS_CPU_BASELINE": "x86-64-v3"
            }
        },
        {
            "name": "clang-asan",
            "displayName": "Clang AddressSanitizer",
            "description": "Debug build with AddressSanitizer for memory error detection",
            "inherits": "clang-debug",
            "cacheVariables": {
                "ENABLE_ASAN": "ON"
            }
        },
        {
            "name": "clang-tsan",
            "displayName": "Clang ThreadSanitizer",
            "description": "Debug build with ThreadSanitizer for data race detection",
            "inherits": "clang-debug",
            "cacheVariables": {
                "ENABLE_TSAN": "ON"
            }
        },
        {
            "name": "clang-ubsan",
            "displayName": "Clang UBSan",
            "description": "Debug build with UndefinedBehaviorSanitizer",
            "inherits": "clang-debug",
            "cacheVariables": {
                "ENABLE_UBSAN": "ON"
            }
        },
        {
            "name": "clang-msan",
            "displayName": "Clang MemorySanitizer",
            "description": "Debug build with MemorySanitizer",
            "inherits": "clang-debug",
            "cacheVariables": {
                "ENABLE_MSAN": "ON"
            }
        },
        {
            "name": "coverage",
            "displayName": "Coverage (GCC)",
            "description": "Debug build with coverage analysis using GCC",
            "inherits": "gcc-debug",
            "cacheVariables": {
                "ENABLE_COVERAGE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "displayName": "GCC Debug Build"
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "displayName": "GCC Release Build"
        },
        {
            "name": "gcc-relwithdebinfo",
            "configurePreset": "gcc-relwithdebinfo",
            "displayName": "GCC RelWithDebInfo Build"
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "displayName": "Clang Debug Build"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "displayName": "Clang Release Build"
        },
        {
            "name": "clang-asan",
            "configurePreset": "clang-asan",
            "displayName": "Clang ASan Build"
        },
        {
            "name": "clang-tsan",
            "configurePreset": "clang-tsan",
            "displayName": "Clang TSan Build"
        },
        {
            "name": "clang-ubsan",
            "configurePreset": "clang-ubsan",
            "displayName": "Clang UBSan Build"
        },
        {
            "name": "clang-msan",
            "configurePreset": "clang-msan",
            "displayName": "Clang MSan Build"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "displayName": "Coverage Build"
        },
        {
            "name": "gcc-v3-release",
            "configurePreset": "gcc-v3-release",
            "displayName": "GCC v3 Release Build"
        },
        {
            "name": "clang-v3-release",
            "configurePreset": "clang-v3-release",
            "displayName": "Clang v3 Release Build"
        }
    ],
    "testPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "displayName": "GCC Debug Tests",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "displayName": "GCC Release Tests",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "displayName": "Clang Debug Tests",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "clang-asan",
            "configurePreset": "clang-asan",
            "displayName": "Clang ASan Tests",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "displayName": "Clang Release Tests",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "clang-tsan",
            "configurePreset": "clang-tsan",
            "displayName": "Clang TSan Tests",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "clang-ubsan",
            "configurePreset": "clang-ubsan",
            "displayName": "Clang UBSan Tests",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "clang-msan",
            "configurePreset": "clang-msan",
            "displayName": "Clang MSan Tests",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "displayName": "Coverage Tests",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            }
        }
    ],
    "packagePresets": [
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "displayName": "Release Package (GCC)"
        }
    ]
}