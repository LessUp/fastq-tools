# ===== 编译产物 =====
*.o
*.a
*.so
*.dll
*.dylib
*.lib

# ===== 构建与安装输出 =====
build*/
!build-config/
build_verify/
install/
install-*/
cmake-build-*/
/bin/
/obj/
/out/
_output/
dist/

# ===== CMake 生成文件 =====
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CMakeUserPresets.json

# ===== Conan 生成文件 =====
conaninfo.txt
conanbuildinfo.*
conan.lock
conan_toolchain.cmake

# Conan CMakeDeps 生成文件（conan install 在 conanfile.py 目录生成）
build-config/dependencies/CMakePresets.json
build-config/dependencies/Find*.cmake
build-config/dependencies/*Config.cmake
build-config/dependencies/*ConfigVersion.cmake
build-config/dependencies/*Targets.cmake
build-config/dependencies/*-Target-*.cmake
build-config/dependencies/*-config.cmake
build-config/dependencies/*-config-version.cmake
build-config/dependencies/*-data.cmake
build-config/dependencies/cmakedeps_macros.cmake
build-config/dependencies/conandeps_legacy.cmake
build-config/dependencies/conanbuild*.sh
build-config/dependencies/conanrun*.sh
build-config/dependencies/deactivate_conan*.sh
build-config/dependencies/module-*.cmake

# ===== Python =====
__pycache__/
*.pyc
*.egg-info/

# ===== IDE 与编辑器 =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ===== AI 工具配置（自动生成，不提交） =====
.worktrees/
.kiro/
.qoder/
.spec-workflow/
cascade/
.claude/
.omc/
superpowers/

# ===== OS 特定文件 =====
.DS_Store
Thumbs.db

# ===== 临时文件 =====
*.tmp
*.log
*.swp
*.bak
.dSYM/

# ===== E2E 测试临时目录 =====
tests/e2e/.tmp/
tests/e2e/.tmp_python/

# ===== 覆盖率与分析数据 =====
coverage/
!build-config/coverage/
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
Testing/

# ===== Fuzz 模糊测试 =====
# libFuzzer 生成的 corpus/crash 文件，仅保留 seed_*.fq 和 README.md
tools/fuzz/corpus/*
!tools/fuzz/corpus/seed_*.fq
!tools/fuzz/corpus/README.md

# ===== 缓存 =====
.cache/
.ccache/

# ===== 工具与分析报告 =====
clang-tidy-fixes.yml
*.sarif
benchmark-*.json
benchmark-*.csv
