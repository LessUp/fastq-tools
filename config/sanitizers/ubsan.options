# UndefinedBehaviorSanitizer (UBSan) Options
#
# Usage: export UBSAN_OPTIONS=$(grep -v '^#' config/sanitizers/ubsan.options | grep -v '^$' | tr '\n' ':')
#
# Documentation: https://clang.llvm.org/docs/UndefinedBehaviorSanitizer.html

# Print stack trace on error
print_stacktrace=1

# Continue running after first error
halt_on_error=0

# Verbosity level
verbosity=0

# Symbolize stack traces
symbolize=1

# Report error type
report_error_type=1

# Silence recoverable errors (set to 0 to see all)
silence_unsigned_overflow=0
