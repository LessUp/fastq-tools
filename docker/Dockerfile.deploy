# =============================================================================
# FastQTools Deploy Image
# =============================================================================
# 独立部署镜像：GCC 15 构建 + 最小化运行时
# 与 Dockerfile.prod 保持一致的工具链和依赖版本
#
# 用法：
#   docker build -f docker/Dockerfile.deploy -t fastqtools:latest ..
#   docker run --rm fastqtools:latest --help
#   docker run --rm -v /data:/app/data fastqtools:latest stat -i /app/data/input.fq
# =============================================================================

# -----------------------------------------------------------------------------
# 构建阶段
# -----------------------------------------------------------------------------
FROM gcc:15.2-bookworm AS builder

ARG DEVCONTAINER_HTTP_PROXY
ARG DEVCONTAINER_HTTPS_PROXY
ARG DEVCONTAINER_ALL_PROXY
ARG DEVCONTAINER_NO_PROXY

ENV HTTP_PROXY=${DEVCONTAINER_HTTP_PROXY}
ENV HTTPS_PROXY=${DEVCONTAINER_HTTPS_PROXY}
ENV ALL_PROXY=${DEVCONTAINER_ALL_PROXY}
ENV NO_PROXY=${DEVCONTAINER_NO_PROXY}
ENV http_proxy=${DEVCONTAINER_HTTP_PROXY}
ENV https_proxy=${DEVCONTAINER_HTTPS_PROXY}
ENV all_proxy=${DEVCONTAINER_ALL_PROXY}
ENV no_proxy=${DEVCONTAINER_NO_PROXY}

RUN set -eux; \
    if [ -n "${DEVCONTAINER_HTTP_PROXY:-}" ] || [ -n "${DEVCONTAINER_HTTPS_PROXY:-}" ]; then \
        : > /etc/apt/apt.conf.d/99proxy; \
        if [ -n "${DEVCONTAINER_HTTP_PROXY:-}" ]; then echo "Acquire::http::Proxy \"${DEVCONTAINER_HTTP_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
        if [ -n "${DEVCONTAINER_HTTPS_PROXY:-}" ]; then echo "Acquire::https::Proxy \"${DEVCONTAINER_HTTPS_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
    fi

# APT 镜像源配置 (中国大陆用户可启用国内镜像加速)
ARG USE_CHINA_MIRROR=0
RUN if [ "${USE_CHINA_MIRROR}" = "1" ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true; \
    fi

# APT 重试配置 (处理镜像临时故障)
RUN echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80retries && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/80retries && \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/80retries

# 安装构建依赖（仅构建所需，不含交互工具）
RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    build-essential \
    ninja-build \
    pkg-config \
    git \
    wget \
    ca-certificates \
    tar \
    xz-utils \
    python3 \
    python3-pip \
    ccache \
    libdeflate-dev \
    zlib1g-dev \
    libtbb-dev \
    && rm -rf /var/lib/apt/lists/*

# CMake 4.x
RUN CMAKE_VERSION=4.0.2 && \
    ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
        amd64) CMAKE_ARCH="x86_64" ;; \
        arm64) CMAKE_ARCH="aarch64" ;; \
        *) echo "Unsupported architecture: $ARCH"; exit 1 ;; \
    esac && \
    wget -q "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}.tar.gz" -O /tmp/cmake.tar.gz && \
    mkdir -p /opt && \
    tar -C /opt -xzf /tmp/cmake.tar.gz && \
    ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}/bin/cmake" /usr/local/bin/cmake && \
    ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}/bin/ctest" /usr/local/bin/ctest && \
    ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}/bin/cpack" /usr/local/bin/cpack && \
    rm -f /tmp/cmake.tar.gz

# Conan 2.x
RUN pip3 install --no-cache-dir --break-system-packages conan==2.24.0

# 设置编译器
ENV CC=gcc
ENV CXX=g++
ENV CONAN_HOME=/root/.conan2
ENV CCACHE_DIR=/root/.ccache
ENV PATH=/usr/lib/ccache:$PATH

WORKDIR /workspace
COPY . .

# 安装依赖并构建
RUN conan profile detect --force
RUN conan install config/dependencies/ --build=missing -s build_type=Release -of=build/gcc-release

RUN cmake -B build/gcc-release -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=build/gcc-release/conan_toolchain.cmake \
    -DCMAKE_C_COMPILER=gcc \
    -DCMAKE_CXX_COMPILER=g++ \
    -DCMAKE_EXE_LINKER_FLAGS="-static-libstdc++ -static-libgcc" \
    -DENABLE_COVERAGE=OFF \
    -DBUILD_TESTING=OFF

RUN ninja -C build/gcc-release

# 收集运行时所需的 GCC 15 共享库到已知路径
RUN mkdir -p /runtime-libs && \
    cp -L "$(gcc -print-file-name=libstdc++.so.6)" /runtime-libs/ && \
    cp -L "$(gcc -print-file-name=libgcc_s.so.1)" /runtime-libs/

# -----------------------------------------------------------------------------
# 运行时阶段
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim

# APT 镜像源配置（从构建阶段继承 USE_CHINA_MIRROR 参数）
ARG USE_CHINA_MIRROR=0
RUN if [ "${USE_CHINA_MIRROR}" = "1" ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true; \
    fi

# APT 重试配置
RUN echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80retries

RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    ca-certificates \
    libtbb12 \
    zlib1g \
    libdeflate0 \
    && rm -rf /var/lib/apt/lists/*

# 非 root 用户
ARG USERNAME=fastqtools
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd -g $USER_GID $USERNAME \
    && useradd -m -s /bin/bash -u $USER_UID -g $USER_GID $USERNAME

WORKDIR /app

# 复制 GCC 15 的 libstdc++ 和 libgcc_s（构建阶段使用 GCC 15，运行时需要匹配版本）
COPY --from=builder /runtime-libs/ /usr/lib/x86_64-linux-gnu/
RUN ldconfig

# 复制构建产物
COPY --from=builder /workspace/build/gcc-release/FastQTools /usr/local/bin/
RUN ln -sf /usr/local/bin/FastQTools /usr/local/bin/fastqtools

# 数据目录
RUN mkdir -p /app/data /app/output && \
    chown -R $USERNAME:$USERNAME /app

USER $USERNAME

ENV PATH=/usr/local/bin:$PATH

ENTRYPOINT ["fastqtools"]
CMD ["--help"]