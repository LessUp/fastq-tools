@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(fmt CONFIG)
find_dependency(TBB CONFIG)
find_dependency(ZLIB)

# Conan 提供的是 fmt::fmt-header-only，需要创建别名 fmt::fmt
if(TARGET fmt::fmt-header-only AND NOT TARGET fmt::fmt)
    add_library(fmt::fmt ALIAS fmt::fmt-header-only)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FastQToolsTargets.cmake")

check_required_components(FastQTools)
